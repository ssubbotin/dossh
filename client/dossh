#!/usr/bin/env python3
"""
dossh - client for DOSSH (https://github.com/ssubbotin/dossh)

M2: connect to a DOSSHD stream, render the DOS text screen live in this
terminal, and forward local keystrokes as KEY events that DOSSHD injects
into the BIOS keyboard buffer. Under QEMU the stream is COM1 bridged to a
TCP port with `-serial tcp:HOST:PORT,server`; connect to that.

    dossh [host] [port]        (default 127.0.0.1 5555)

Keys are forwarded when stdin is a terminal (Ctrl-] disconnects, like
telnet); with stdin redirected the client is a read-only viewer.
MIT License. Copyright (c) 2026 Sergey Subbotin.
"""
import os
import select
import socket
import sys
import time

MAGIC = b"DSSH"
HDR_LEN = 14
QUIT_BYTE = 0x1D  # Ctrl-], like telnet's escape

# VGA palette index -> ANSI colour code offset (VGA and ANSI order differ)
VGA2ANSI = [0, 4, 2, 6, 1, 5, 3, 7]  # blk blu grn cyn red mag brn wht

# ---- keymap: terminal bytes -> BIOS (scancode, ascii, modifiers) ---------
#
# Scancode-set-1 make codes for the US layout; the ascii byte carries the
# character (already shifted by the local terminal), so shifted characters
# reuse their key's scancode. Extended keys (arrows, F-keys, ...) go out
# with ascii 0, the way INT 16h reports them.

ASCII_SCAN = {}
for _i, _c in enumerate("1234567890-="):
    ASCII_SCAN[_c] = 0x02 + _i
for _i, _c in enumerate("qwertyuiop[]"):
    ASCII_SCAN[_c] = 0x10 + _i
for _i, _c in enumerate("asdfghjkl;'`"):
    ASCII_SCAN[_c] = 0x1E + _i
for _i, _c in enumerate("\\zxcvbnm,./"):
    ASCII_SCAN[_c] = 0x2B + _i
ASCII_SCAN[" "] = 0x39

SHIFTED = dict(zip('!@#$%^&*()_+{}:"~<>?|', "1234567890-=[];'`,./\\"))

# CSI final byte -> extended scancode (ESC [ A etc.)
CSI_FINAL = {ord("A"): 0x48, ord("B"): 0x50, ord("C"): 0x4D, ord("D"): 0x4B,
             ord("H"): 0x47, ord("F"): 0x4F}
# CSI number~ -> extended scancode (ESC [ 5 ~ etc.)
CSI_TILDE = {1: 0x47, 2: 0x52, 3: 0x53, 4: 0x4F, 5: 0x49, 6: 0x51,
             11: 0x3B, 12: 0x3C, 13: 0x3D, 14: 0x3E,          # F1-F4 (old)
             15: 0x3F, 17: 0x40, 18: 0x41, 19: 0x42,          # F5-F8
             20: 0x43, 21: 0x44, 23: 0x57, 24: 0x58}          # F9-F12
# SS3 final byte -> extended scancode (ESC O P = F1 etc.)
SS3_FINAL = {ord("P"): 0x3B, ord("Q"): 0x3C, ord("R"): 0x3D, ord("S"): 0x3E,
             ord("H"): 0x47, ord("F"): 0x4F}

ESC_KEY = (0x01, 0x1B, 0)


def map_byte(b):
    """One plain input byte -> a key event, or None if unmapped."""
    if b in (0x0D, 0x0A):
        return (0x1C, 0x0D, 0)                 # Enter
    if b == 0x09:
        return (0x0F, 0x09, 0)                 # Tab
    if b in (0x7F, 0x08):
        return (0x0E, 0x08, 0)                 # Backspace (terminals send DEL)
    if 32 <= b < 127:
        ch = chr(b)
        base = SHIFTED.get(ch) or (ch.lower() if "A" <= ch <= "Z" else ch)
        scan = ASCII_SCAN.get(base)
        return (scan, b, 0) if scan else None
    if 1 <= b <= 26:                           # Ctrl+A .. Ctrl+Z
        scan = ASCII_SCAN.get(chr(b + 96))
        return (scan, b, 0) if scan else None
    return None


def parse_input(data, flush=False):
    """Terminal input bytes -> ([(scancode, ascii, mods)], leftover).

    A trailing lone ESC (or unfinished escape sequence) is left in
    `leftover` so the caller can wait for the rest; with flush=True a lone
    ESC becomes the ESC key and an unfinished sequence is dropped.
    """
    events = []
    i, n = 0, len(data)
    while i < n:
        b = data[i]
        if b != 0x1B:
            ev = map_byte(b)
            if ev:
                events.append(ev)
            i += 1
            continue
        if i + 1 >= n:                         # lone ESC at the end
            if flush:
                events.append(ESC_KEY)
                i += 1
            break
        nxt = data[i + 1]
        if nxt == ord("["):                    # CSI: ESC [ params final
            j = i + 2
            while j < n and data[j : j + 1] in b"0123456789;":
                j += 1
            if j >= n:                         # sequence not complete yet
                if flush:
                    i = n                      # drop the fragment
                break
            fin = data[j]
            if fin == ord("~"):
                num_s = bytes(data[i + 2 : j]).split(b";")[0]
                scan = CSI_TILDE.get(int(num_s) if num_s.isdigit() else 0)
            else:
                scan = CSI_FINAL.get(fin)
            if scan:
                events.append((scan, 0, 0))
            i = j + 1
        elif nxt == ord("O"):                  # SS3: ESC O final
            if i + 2 >= n:
                if flush:
                    i = n
                break
            scan = SS3_FINAL.get(data[i + 2])
            if scan:
                events.append((scan, 0, 0))
            i += 3
        else:                                  # ESC + something else
            events.append(ESC_KEY)
            i += 1
    return events, bytes(data[i:])


def key_frame(scan, asc, mods=0):
    """Client->server KEY frame: DSSH, type=2, scancode, ascii, modifiers."""
    return MAGIC + bytes([2, scan, asc, mods])


def send_events(sock, events):
    for scan, asc, mods in events:
        sock.sendall(key_frame(scan, asc, mods))
        if len(events) > 4:
            # paste pacing: the BIOS type-ahead ring holds only 15 keys
            time.sleep(0.03)


# ---- screen rendering ----------------------------------------------------

def sgr(attr):
    fg = attr & 0x0F
    bg = (attr >> 4) & 0x07
    fg_code = (30 + VGA2ANSI[fg]) if fg < 8 else (90 + VGA2ANSI[fg - 8])
    bg_code = 40 + VGA2ANSI[bg]
    return "\x1b[0;%d;%dm" % (fg_code, bg_code)


def render(cols, rows, cur_row, cur_col, cells):
    out = ["\x1b[H"]  # cursor home (no full clear -> less flicker)
    last = None
    for r in range(rows):
        for c in range(cols):
            i = (r * cols + c) * 2
            ch, attr = cells[i], cells[i + 1]
            if attr != last:
                out.append(sgr(attr))
                last = attr
            out.append(bytes([ch]).decode("cp437"))
        out.append("\x1b[0m\x1b[K")  # reset + clear to EOL
        if r < rows - 1:
            out.append("\r\n")
        last = None
    # park the terminal cursor where the DOS cursor is
    out.append("\x1b[%d;%dH" % (cur_row + 1, cur_col + 1))
    sys.stdout.write("".join(out))
    sys.stdout.flush()


def recv_and_render(sock, buf):
    """One recv; render every complete SCREEN frame now in the buffer."""
    chunk = sock.recv(65536)
    if not chunk:
        raise ConnectionError("stream closed")
    buf += chunk
    frames = 0
    while True:
        while len(buf) >= HDR_LEN and buf[:4] != MAGIC:
            del buf[0]  # resync on magic
        if len(buf) < HDR_LEN:
            return frames
        typ = buf[4]
        cols, rows = buf[7], buf[8]
        cur_row, cur_col = buf[9], buf[10]
        plen = buf[11] | (buf[12] << 8)
        if len(buf) < HDR_LEN + plen:
            return frames
        payload = bytes(buf[HDR_LEN : HDR_LEN + plen])
        del buf[: HDR_LEN + plen]
        if typ == 1 and plen == cols * rows * 2:
            render(cols, rows, cur_row, cur_col, payload)
            frames += 1


# ---- main loops ------------------------------------------------------------

def watch_only(sock):
    """Render frames forever (stdin is not a terminal)."""
    buf = bytearray()
    frames = 0
    while True:
        frames += recv_and_render(sock, buf)


def interactive(sock):
    import termios
    import tty

    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    tty.setraw(fd)
    buf = bytearray()
    pending = b""
    try:
        while True:
            timeout = 0.03 if pending else None
            r, _, _ = select.select([sock, fd], [], [], timeout)
            if not r and pending:
                # no continuation arrived: that ESC was the ESC key
                events, pending = parse_input(pending, flush=True)
                send_events(sock, events)
                continue
            if sock in r:
                recv_and_render(sock, buf)
            if fd in r:
                data = os.read(fd, 1024)
                if not data:
                    return
                data = pending + data
                quit_at = data.find(bytes([QUIT_BYTE]))
                if quit_at >= 0:
                    data = data[:quit_at]
                events, pending = parse_input(data)
                send_events(sock, events)
                if quit_at >= 0:
                    return
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


def main():
    host = sys.argv[1] if len(sys.argv) > 1 else "127.0.0.1"
    port = int(sys.argv[2]) if len(sys.argv) > 2 else 5555
    sys.stderr.write("dossh: connecting to %s:%d ...\n" % (host, port))
    sock = socket.create_connection((host, port))
    sys.stdout.write("\x1b[2J")  # clear once
    try:
        if sys.stdin.isatty():
            sys.stderr.write("dossh: keys are forwarded; Ctrl-] quits\r\n")
            interactive(sock)
            sys.stdout.write("\x1b[0m\n")
            sys.stderr.write("dossh: disconnected\n")
        else:
            watch_only(sock)
    except (KeyboardInterrupt, ConnectionError) as e:
        sys.stdout.write("\x1b[0m\n")
        sys.stderr.write("dossh: %s\n" % (e or "closed",))
    finally:
        sock.close()


if __name__ == "__main__":
    main()
